function TripleElliptic(N, I)
    p := I[1]; q := I[2]; r := I[3];
    A := (N[q]-N[p]) + (N[r]-N[p]);
    B := (N[q]-N[p])*(N[r]-N[p]);
    E := EllipticCurve([ Q | 0, A, 0, B, 0 ]);
    return E, p;
end function;

function QuarticElliptic(N, p)
    J := [ i : i in [1..4] | i ne p ];
    d1 := N[J[1]] - N[p];
    d2 := N[J[2]] - N[p];
    d3 := N[J[3]] - N[p];
    a := d1*d2*d3;
    b := d1*d2 + d1*d3 + d2*d3;
    c := d1 + d2 + d3;
    E := EllipticCurve([ Q | 0, b, 0, a*c, a^2 ]);
    return E, p, a;
end function;

function TripleImage(N, I, E, piv, tval, yvec)
    X := tval + N[piv];
    Y := &*[ yvec[i] : i in I ];
    return E![X, Y, 1];
end function;

function QuarticImage(N, E, piv, a, tval, yvec)
    den := tval + N[piv];
    assert den ne 0;
    X := a/den;
    Y := a*(&*yvec)/(den^2);
    return E![X, Y, 1];
end function;

function CompatibilityCurve(N, m)
    R<W> := PolynomialRing(Q);
    I := [ i : i in [1..4] | i ne m ];
    f := &*[ W^2 + N[i] - N[m] : i in I ];
    D := HyperellipticCurve(f);
    return D, I, f;
end function;

function SquareRational(x)
    ok, root := IsSquare(x);
    return ok, root;
end function;

function LiftsToC(N, m, Wval)
    tval := Wval^2 - N[m];
    ys := [];
    for i in [1..4] do
        ok, y := IsSquare(tval + N[i]);
        if not ok then
            return false, _, _;
        end if;
        Append(~ys, y);
    end for;
    return true, tval, ys;
end function;

