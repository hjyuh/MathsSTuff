PORT=3000
HOST=0.0.0.0
RBI_PUBLIC_BASE_URL=http://localhost:3000
RBI_TRUST_PROXY=true
RBI_ENFORCE_HTTPS=false

# Comma-separated list of username:password credentials.
# Example: RBI_USERS=alice:correct-horse,bob:battery-staple
RBI_USERS=admin:change-me-now
RBI_ADMIN_USERS=admin
RBI_AUTH_COOKIE_NAME=rbi_auth
RBI_PUBLIC_SITE_PATH=/share
RBI_PRIVATE_SITE_PATH=/private
RBI_PRIVATE_SITE_USERS=admin
RBI_HOME_PC_USERS=malek
RBI_HOME_PC_URL=https://accounts.google.com/AccountChooser?continue=https%3A%2F%2Fremotedesktop.google.com%2Faccess
RBI_AUTH_SESSION_TTL_MINUTES=720
RBI_MAX_SESSIONS_PER_USER=2

RBI_DOCKER_BIN=docker
RBI_WORKER_PROVIDER=docker
RBI_WORKSPACE_IMAGE=kasmweb/chromium:1.17.0
RBI_DOCKER_RUNTIME=
RBI_ISOLATION_MODE=

RBI_SESSION_TTL_MINUTES=480
RBI_STARTUP_TIMEOUT_SECONDS=45
RBI_LISTEN_HOST=127.0.0.1

# Profile persistence is disabled by default.
# Set RBI_PERSIST_PROFILES=true to persist user profiles between sessions.
RBI_PERSIST_PROFILES=false
RBI_PROFILE_SCOPE=user
RBI_PROFILE_VOLUME_PREFIX=rbi-profile
RBI_WORKSPACE_RESOLUTION=1920x1080
RBI_WORKSPACE_MAX_VIDEO_RESOLUTION=3840x2160
RBI_WORKSPACE_MIN_QUALITY=9
RBI_WORKSPACE_MAX_QUALITY=9
RBI_WORKSPACE_BROWSER_ZOOM=1.25

RBI_AUDIO_ENABLED=true
# Set true for higher-fidelity PCM audio (higher bandwidth usage).
RBI_AUDIO_PCM=false
RBI_PREPULL_WORKSPACE_IMAGE=true
RBI_IMAGE_PULL_TIMEOUT_MINUTES=15

# Controlled DNS filtering lab.
# Enable only on networks/devices you administer.
RBI_DNS_LAB_ENABLED=false
# system, cloudflare-malware, cloudflare-family, custom-dns, or browser-doh
RBI_WORKER_DNS_MODE=system
# Used when RBI_WORKER_DNS_MODE=custom-dns, or as optional bootstrap DNS for browser-doh.
RBI_WORKER_DNS_SERVERS=
# Used when RBI_WORKER_DNS_MODE=browser-doh. Defaults to Cloudflare public DoH if blank in the UI.
RBI_CHROME_DOH_TEMPLATE=https://cloudflare-dns.com/dns-query

RBI_ENABLE_JANITOR=true
RBI_JANITOR_INTERVAL_SECONDS=120
RBI_APP_LABEL=remote-browser-isolation-mvp

# Optional native TLS termination (key/cert required together).
RBI_TLS_KEY_FILE=
RBI_TLS_CERT_FILE=
RBI_TLS_CA_FILE=
